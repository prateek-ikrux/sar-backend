# development adds stack traces and upstream error detail to error responses.
# Leave unset (or production) anywhere but your own machine; compose sets it itself.
NODE_ENV=development
PORT=

MONGODB_URI=
ATS_DB_NAME=
PROFILES_COLLECTION=
SEARCH_AND_RETRIEVAL_DB_NAME=

# Comma-separated browser origins allowed to call the API, e.g.
# http://localhost:5173,http://localhost:3000 ; * allows any origin
CORS_ORIGIN=
# Set only behind a reverse proxy: hop count (e.g. 1) so rate limits see the client IP
TRUST_PROXY=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=
MINIO_PREFIX=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# The frontend URL, used for sign-in links in emails, e.g. https://sar.ikrux.com
APP_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
